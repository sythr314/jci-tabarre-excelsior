# ============================================================
# JCI Tabarre Excelsior — Variables d'Environnement
# Copiez ce fichier vers .env.local et renseignez les valeurs
# ============================================================

# URL du site (utilisé pour les redirections, liens d'invitation et CSRF)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── SUPABASE ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# ATTENTION: La clé service role ne doit JAMAIS avoir le préfixe NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── SANITY CMS ─────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=your-dataset-name
SANITY_WEBHOOK_SECRET=your-strong-random-secret-here

# ─── EMAIL (RESEND) ─────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=your-email@example.com
EMAIL_TO=your-admin@example.com

# ─── GOOGLE SERVICE ACCOUNT (SHEETS) ────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── UPSTASH REDIS (RATE LIMITING) ──────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here
